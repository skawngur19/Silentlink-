rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function knownSign(signId) {
      return signId in [
        'hello', 'thank-you', 'please', 'yes', 'no', 'mom', 'dad',
        'eat', 'drink', 'happy', 'sad', 'more', 'sorry'
      ];
    }

    function ownsLearner(learnerId) {
      return hasRole('teacher')
        && get(/databases/$(database)/documents/learners/$(learnerId)).data.ownerUid == request.auth.uid;
    }

    function linkedLearner(learnerId) {
      return hasRole('learner')
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.learnerId == learnerId;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /learners/{learnerId} {
      allow read: if (hasRole('teacher') && resource.data.ownerUid == request.auth.uid)
        || linkedLearner(learnerId);
      allow create: if hasRole('teacher')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 32
        && request.resource.data.grade in ['Kinder', 'Grade 1', 'Grade 2']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['nickname', 'grade', 'ownerUid', 'createdAt']);
      allow update, delete: if false;

      match /attempts/{attemptId} {
        allow read: if ownsLearner(learnerId) || linkedLearner(learnerId);
        allow create, update, delete: if false;
      }
    }

    match /signs/{signId} {
      allow read: if signedIn();
      allow create: if hasRole('teacher')
        && knownSign(signId)
        && request.resource.data.id == signId
        && request.resource.data.gloss is string
        && request.resource.data.gloss.size() <= 80
        && request.resource.data.category is string
        && request.resource.data.grade in ['Kinder', 'Grade 1', 'Grade 2']
        && request.resource.data.status in ['Validated', 'Under Review', 'Draft', 'Archived']
        && (!('pinned' in request.resource.data) || request.resource.data.pinned is bool)
        && request.resource.data.keys().hasOnly([
          'id', 'gloss', 'category', 'grade', 'status', 'consultant',
          'validated', 'added', 'handshape', 'movement', 'variants',
          'variantNote', 'glyph', 'pinned'
        ]);
      allow update: if hasRole('consultant')
        && knownSign(signId)
        && request.resource.data.id == signId
        && request.resource.data.keys().hasOnly([
          'id', 'gloss', 'category', 'grade', 'status', 'consultant',
          'validated', 'added', 'handshape', 'movement', 'variants',
          'variantNote', 'glyph', 'pinned'
        ]);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
